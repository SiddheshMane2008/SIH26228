{
  "$defs": {
    "DispositionEnum": {
      "enum": [
        "ACCEPT",
        "REVIEW",
        "QUARANTINE"
      ],
      "title": "DispositionEnum",
      "type": "string"
    },
    "Finding": {
      "description": "Standardized finding schema across all VisionGuard modules.",
      "properties": {
        "finding_id": {
          "description": "Unique deterministic identifier, e.g. FIND-DS-001",
          "title": "Finding Id",
          "type": "string"
        },
        "module": {
          "$ref": "#/$defs/ModuleEnum",
          "description": "Reporting engine module"
        },
        "asset": {
          "description": "Target file, batch, model, or record ID",
          "title": "Asset",
          "type": "string"
        },
        "reason": {
          "description": "Human-readable description of detected condition",
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "description": "Concrete forensic evidence metrics/hashes",
          "title": "Evidence",
          "type": "object"
        },
        "severity": {
          "$ref": "#/$defs/SeverityEnum",
          "description": "Assessed impact severity"
        },
        "confidence": {
          "description": "Confidence score 0.0 to 1.0",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "disposition": {
          "$ref": "#/$defs/DispositionEnum",
          "description": "Recommended handling disposition"
        },
        "recommended_action": {
          "description": "Actionable remediation guidance",
          "title": "Recommended Action",
          "type": "string"
        },
        "timestamp": {
          "description": "ISO 8601 UTC timestamp",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "module",
        "asset",
        "reason",
        "severity",
        "confidence",
        "disposition",
        "recommended_action",
        "timestamp"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ModuleEnum": {
      "enum": [
        "DATA_SENTINEL",
        "MODEL_AUDITOR",
        "PROVENANCE_ENGINE",
        "SHIFT_DIAGNOSTICIAN",
        "BLAST_RADIUS",
        "RED_TEAM",
        "GOVERNANCE"
      ],
      "title": "ModuleEnum",
      "type": "string"
    },
    "SeverityEnum": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "SeverityEnum",
      "type": "string"
    }
  },
  "description": "Audit result for visual and embedding distribution shift.",
  "properties": {
    "baseline_id": {
      "title": "Baseline Id",
      "type": "string"
    },
    "evaluation_id": {
      "title": "Evaluation Id",
      "type": "string"
    },
    "brightness_psi": {
      "title": "Brightness Psi",
      "type": "number"
    },
    "contrast_psi": {
      "title": "Contrast Psi",
      "type": "number"
    },
    "sharpness_wasserstein": {
      "title": "Sharpness Wasserstein",
      "type": "number"
    },
    "color_distribution_divergence": {
      "title": "Color Distribution Divergence",
      "type": "number"
    },
    "embedding_drift_score": {
      "title": "Embedding Drift Score",
      "type": "number"
    },
    "composite_risk_score": {
      "title": "Composite Risk Score",
      "type": "number"
    },
    "characterization": {
      "title": "Characterization",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "overall_disposition": {
      "$ref": "#/$defs/DispositionEnum"
    },
    "confidence": {
      "title": "Confidence",
      "type": "number"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "baseline_id",
    "evaluation_id",
    "brightness_psi",
    "contrast_psi",
    "sharpness_wasserstein",
    "color_distribution_divergence",
    "embedding_drift_score",
    "composite_risk_score",
    "characterization",
    "overall_disposition",
    "confidence"
  ],
  "title": "ShiftDiagnosticianResult",
  "type": "object"
}